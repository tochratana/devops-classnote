        }
      ],
      "updated": 1769048123009,
      "link": null,
      "locked": false,
      "text": "1️⃣ kube-apiserver\nRole: Front door of Kubernetes\n- Every command goes through it:\n    - kubectl apply\n    - UI\n    - Other components\n    - Talks to etcd\n-> If API server is down → cluster is unusable",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1️⃣ kube-apiserver\nRole: Front door of Kubernetes\n- Every command goes through it:\n    - kubectl apply\n    - UI\n    - Other components\n    - Talks to etcd\n-> If API server is down → cluster is unusable",
      "autoResize": true,
      "lineHeight": 1.35
    },
