      ],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 722387435,
      "version": 242,
      "versionNonce": 455609099,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1769049426563,
      "link": null,
      "locked": false,
      "text": "How Everything Works Together (Real Flow)\nLet’s simulate 👇\n1.You run: kubectl apply -f app.yaml\n2.kube-apiserver receives request\n3.Data stored in etcd\n4.Scheduler picks a node\n5.kubelet on that node:\n    - Pulls image from registry\n    - Creates Pod\n6.kube-proxy exposes networking\n7.Controller watches & fixes issues\n💡 This is the control loop",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How Everything Works Together (Real Flow)\nLet’s simulate 👇\n1.You run: kubectl apply -f app.yaml\n2.kube-apiserver receives request\n3.Data stored in etcd\n4.Scheduler picks a node\n5.kubelet on that node:\n    - Pulls image from registry\n    - Creates Pod\n6.kube-proxy exposes networking\n7.Controller watches & fixes issues\n💡 This is the control loop",
      "autoResize": true,
      "lineHeight": 1.35
    },
