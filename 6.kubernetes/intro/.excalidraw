      ],
      "updated": 1769048354443,
      "link": null,
      "locked": false,
      "text": "4️⃣ kube-controller-manager\nRole: Auto-fixer 🔧\nControllers watch the cluster and fix problems:\nExamples:\n- Pod dies → create new one\n- Node goes down → move Pods\n- Replicas ≠ desired → fix it\n-> Controllers keep desired state = actual state ",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4️⃣ kube-controller-manager\nRole: Auto-fixer 🔧\nControllers watch the cluster and fix problems:\nExamples:\n- Pod dies → create new one\n- Node goes down → move Pods\n- Replicas ≠ desired → fix it\n-> Controllers keep desired state = actual state ",
      "autoResize": true,
      "lineHeight": 1.35
    },
