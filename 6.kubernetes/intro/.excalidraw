        }
      ],
      "updated": 1769048702905,
      "link": null,
      "locked": false,
      "text": "2️⃣ Container Runtime\nRole: Actually runs containers 🐳\nExamples:\n- containerd\n- CRI-O\n- Docker (older)\nIt:\n- Pulls images\n- Starts containers\n- Stops containers",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2️⃣ Container Runtime\nRole: Actually runs containers 🐳\nExamples:\n- containerd\n- CRI-O\n- Docker (older)\nIt:\n- Pulls images\n- Starts containers\n- Stops containers",
      "autoResize": true,
      "lineHeight": 1.35
    },
