    {
      "id": "JBWUvNh-4Mx9QENfNYUVc",
      "type": "text",
      "x": 1051.0468578140014,
      "y": 961.8856345401962,
      "width": 324.71966552734375,
      "height": 259.20000000000005,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
